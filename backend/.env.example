# ── Banco de dados (Admin Local — SQLite local ou Postgres) ────────────────────
DATABASE_URL=sqlite:///./leilao.db

# ── JWT Secret do Supabase (Authentication → JWT Settings no painel) ───────────
SUPABASE_JWT_SECRET=sua_jwt_secret_aqui

# ── Gemini Vision API (https://aistudio.google.com/app/apikey) ─────────────────
GEMINI_API_KEY=sua_chave_gemini_aqui

# ── VPS Relay — URL da sua VPS + Token compartilhado ──────────────────────────
# O admin local envia dados processados para a VPS via HTTP
VPS_URL=https://sua-vps.com
# Token secreto: deve ser IGUAL ao ADMIN_SECRET_TOKEN no .env da VPS
# Gere: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_TOKEN=troque-por-um-token-forte-e-secreto

# ================================================================
# VPS Relay — variáveis de ambiente
# ================================================================

# Banco de dados (Postgres na VPS ou SQLite para teste)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/leilao_db

# JWT Secret do painel Supabase (Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=seu-jwt-secret-do-supabase

# Token secreto compartilhado com o Admin Local
# Gere um token forte: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_TOKEN=troque-por-um-token-forte-e-secreto

# Chave Gemini para processar prints dos clientes
GEMINI_API_KEY=sua-chave-gemini-aqui
